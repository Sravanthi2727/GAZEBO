<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hospital_nav_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.85 0.92 0.95 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <diffuse>1 1 1 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.88 0.88 0.90 1</ambient><diffuse>0.88 0.88 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- STATIC MAP (also encoded in hospital_nav.py) -->
    <model name="wall_south">
      <static>true</static><pose>6.0 -1.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>12.2 0.20 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>12.2 0.20 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-0.1 0.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.20 3.6 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.20 3.6 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>12.1 0.0 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.20 3.6 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.20 3.6 1.2</size></box></geometry></collision>
      </link>
    </model>
    <!-- North corridor wall is split so the patient room opens off the corridor -->
    <model name="wall_north_a">
      <static>true</static><pose>3.6 1.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>7.4 0.20 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>7.4 0.20 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_north_b">
      <static>true</static><pose>11.05 1.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.1 0.20 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>2.1 0.20 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="room_west">
      <static>true</static><pose>7.3 3.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.20 4.0 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.20 4.0 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="room_east">
      <static>true</static><pose>10.0 3.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.20 4.0 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.20 4.0 1.2</size></box></geometry></collision>
      </link>
    </model>
    <model name="room_north">
      <static>true</static><pose>8.65 5.7 0.6 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.9 0.20 1.2</size></box></geometry><material><ambient>0.80 0.82 0.85 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>2.9 0.20 1.2</size></box></geometry></collision>
      </link>
    </model>

    <model name="pharmacy_pad">
      <static>true</static><pose>1.4 0.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.4 1.4 0.02</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="patient_pad">
      <static>true</static><pose>8.65 4.6 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.4 1.4 0.02</size></box></geometry>
          <material><ambient>0.10 0.75 0.25 1</ambient><diffuse>0.10 0.75 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Person NOT in the static map — robot must detect with LiDAR and replan -->
    <model name="visitor">
      <static>true</static><pose>5.2 0.15 0.8 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.28</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.85 0.2 0.2 1</ambient><diffuse>0.85 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>1.6</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="hospital_robot">
      <pose>1.4 0.0 0.25 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass><inertia><ixx>0.035</ixx><iyy>0.078</iyy><izz>0.095</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.8 0.6 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.3</size></box></geometry>
          <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <link name="caster">
        <pose>-0.30 0 -0.12 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="lidar_link">
        <pose>0.22 0 0.40 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="lidar_visual"><geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>8</update_rate>
          <topic>/robot/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>120</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.30</min><max>8.0</max><resolution>0.05</resolution></range>
          </lidar>
        </sensor>
      </link>
      <joint name="lwj" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rwj" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="cj" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>lwj</left_joint>
        <right_joint>rwj</right_joint>
        <wheel_separation>0.72</wheel_separation>
        <wheel_radius>0.20</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/robot/odometry</odom_topic>
        <topic>/robot/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
