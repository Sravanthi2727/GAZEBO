<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="bug_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.88 0.88 0.88 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.82 0.82 0.82 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer building shell (inner free space roughly 0.2..11.8 x 0.2..7.8) -->
    <model name="outer_south">
      <static>true</static><pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>12.4 0.25 1</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>12.4 0.25 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="outer_north">
      <static>true</static><pose>6 8 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>12.4 0.25 1</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>12.4 0.25 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="outer_west">
      <static>true</static><pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.25 8.25 1</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.25 8.25 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="outer_east">
      <static>true</static><pose>12 4 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.25 8.25 1</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.25 8.25 1</size></box></geometry></collision>
      </link>
    </model>

    <!-- Main blocking wall on the start-goal line. Gap at the NORTH end only (y > 5.7). -->
    <model name="block_wall">
      <static>true</static><pose>5.0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.30 5.6 1</size></box></geometry>
          <material><ambient>0.62 0.32 0.12 1</ambient><diffuse>0.62 0.32 0.12 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.30 5.6 1</size></box></geometry></collision>
      </link>
    </model>

    <!-- Dead-end alcove in the north-east. Following walls will exit it. -->
    <model name="deadend_south">
      <static>true</static><pose>9.6 5.2 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>3.4 0.25 1</size></box></geometry>
          <material><ambient>0.55 0.22 0.18 1</ambient></material>
        </visual>
        <collision name="c"><geometry><box><size>3.4 0.25 1</size></box></geometry></collision>
      </link>
    </model>
    <model name="deadend_west">
      <static>true</static><pose>7.9 6.5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.25 2.6 1</size></box></geometry>
          <material><ambient>0.55 0.22 0.18 1</ambient></material>
        </visual>
        <collision name="c"><geometry><box><size>0.25 2.6 1</size></box></geometry></collision>
      </link>
    </model>

    <!-- Dead-end stub on the west. Passage around the main wall stays ~2 m wide. -->
    <model name="west_stub">
      <static>true</static><pose>1.4 6.4 0.5 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.4 0.25 1</size></box></geometry>
          <material><ambient>0.40 0.40 0.45 1</ambient></material>
        </visual>
        <collision name="c"><geometry><box><size>2.4 0.25 1</size></box></geometry></collision>
      </link>
    </model>

    <model name="goal_pad">
      <static>true</static><pose>10.5 1.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.4 1.4 0.02</size></box></geometry>
          <material><ambient>0.05 0.75 0.15 1</ambient><diffuse>0.05 0.75 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bug_robot">
      <pose>1.5 1.5 0.25 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass><inertia><ixx>0.035</ixx><iyy>0.078</iyy><izz>0.095</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.8 0.6 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.3</size></box></geometry>
          <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="left_wheel">
        <pose>0 0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
      </link>
      <link name="caster">
        <pose>-0.30 0 -0.12 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="lidar_link">
        <pose>0.22 0 0.40 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="lidar_visual"><geometry><cylinder><radius>0.10</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>8</update_rate>
          <topic>/robot/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>120</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.30</min><max>8.0</max><resolution>0.05</resolution></range>
          </lidar>
        </sensor>
      </link>
      <joint name="lwj" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rwj" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="cj" type="fixed"><parent>base_link</parent><child>caster</child></joint>
      <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>lwj</left_joint>
        <right_joint>rwj</right_joint>
        <wheel_separation>0.72</wheel_separation>
        <wheel_radius>0.20</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/robot/odometry</odom_topic>
        <topic>/robot/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
