<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse_world">
    
    <!-- PHYSICS & PLUGINS -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- THIS PLUGIN FIXES THE BLACK COLORS IN VIRTUALBOX -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- BRIGHT DAYLIGHT SETTINGS -->
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.8 0.9 1.0 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- GROUND -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WAREHOUSE STORAGE RACKS (Brown) -->
    <model name="rack_1">
      <static>true</static><pose>3 2 1 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2 4 2</size></box></geometry><material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2 4 2</size></box></geometry></collision>
      </link>
    </model>
    
    <model name="rack_2">
      <static>true</static><pose>7 -2 1 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2 4 2</size></box></geometry><material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2 4 2</size></box></geometry></collision>
      </link>
    </model>

    <!-- LOADING (Green) & UNLOADING ZONES (Red) -->
    <model name="loading_zone">
      <static>true</static><pose>0 0 0.01 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>1.5 1.5 0.02</size></box></geometry><material><ambient>0.0 0.8 0.0 1</ambient><diffuse>0.0 0.8 0.0 1</diffuse></material></visual></link>
    </model>
    <model name="unloading_zone">
      <static>true</static><pose>8 3 0.01 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>1.5 1.5 0.02</size></box></geometry><material><ambient>0.8 0.0 0.0 1</ambient><diffuse>0.8 0.0 0.0 1</diffuse></material></visual></link>
    </model>

    <!-- STABLE ROBOT MODEL (Blue) -->
    <model name="warehouse_robot">
      <pose>0 0 0.25 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass><inertia><ixx>0.035</ixx><iyy>0.078</iyy><izz>0.095</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.8 0.6 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.3</size></box></geometry><material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material></visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.36 0.0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.20</radius><length>0.12</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>

      <link name="caster">
        <pose>-0.30 0 -0.12 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>

      <joint name="lwj" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rwj" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="cj" type="fixed"><parent>base_link</parent><child>caster</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>lwj</left_joint>
        <right_joint>rwj</right_joint>
        <wheel_separation>0.72</wheel_separation>
        <wheel_radius>0.20</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/robot/odometry</odom_topic>
        <topic>/robot/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>