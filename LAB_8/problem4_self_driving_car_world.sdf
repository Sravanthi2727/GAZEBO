<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="problem4_road_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.95 0.95 0.95 1</ambient>
      <background>0.82 0.90 0.96 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.3 -1</direction>
    </light>

    <!-- Ground Grass Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.25 0.65 0.25 1</ambient><diffuse>0.25 0.65 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Asphalt Road Surface (Straight Segment & Track) -->
    <!-- Road Base (Length: 30m, Width: 4.5m) -->
    <model name="road_surface">
      <static>true</static><pose>12.0 0.0 0.005 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>32.0 4.6 0.01</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer Left Road Boundary (White Line) -->
    <model name="line_outer_left">
      <static>true</static><pose>12.0 2.1 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>32.0 0.15 0.01</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link>
    </model>

    <!-- Outer Right Road Boundary (White Line) -->
    <model name="line_outer_right">
      <static>true</static><pose>12.0 -2.1 0.01 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>32.0 0.15 0.01</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link>
    </model>

    <!-- Yellow Dashed Center Lane Markings -->
    <model name="dash_1"><static>true</static><pose>0.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_2"><static>true</static><pose>4.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_3"><static>true</static><pose>8.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_4"><static>true</static><pose>12.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_5"><static>true</static><pose>16.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_6"><static>true</static><pose>20.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>
    <model name="dash_7"><static>true</static><pose>24.0 0.0 0.012 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>1.6 0.14 0.01</size></box></geometry><material><ambient>1.0 0.85 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual></link></model>

    <!-- Side Road Curbs -->
    <model name="curb_left"><static>true</static><pose>12.0 2.35 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>32.0 0.25 0.2</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual><collision name="c"><geometry><box><size>32.0 0.25 0.2</size></box></geometry></collision></link></model>
    <model name="curb_right"><static>true</static><pose>12.0 -2.35 0.1 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>32.0 0.25 0.2</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual><collision name="c"><geometry><box><size>32.0 0.25 0.2</size></box></geometry></collision></link></model>

    <!-- Road Obstacles to Detect with LiDAR -->
    <model name="road_obstacle_1">
      <static>true</static><pose>10.0 0.8 0.4 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.1 1</ambient><diffuse>0.9 0.2 0.1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="road_obstacle_2">
      <static>true</static><pose>19.0 -0.8 0.4 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
      </link>
    </model>

    <!-- Four-Wheel Autonomous Vehicle with Camera & LiDAR -->
    <model name="car">
      <pose>0.0 0.9 0.22 0 0 0</pose>
      <link name="chassis">
        <inertial><mass>3.0</mass><inertia><ixx>0.08</ixx><iyy>0.15</iyy><izz>0.20</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>1.0 0.6 0.3</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>1.0 0.6 0.3</size></box></geometry>
          <material><ambient>0.1 0.3 0.85 1</ambient><diffuse>0.1 0.3 0.85 1</diffuse></material>
        </visual>
        <!-- Windshield visual -->
        <visual name="glass">
          <pose>0.15 0 0.2 0 0.4 0</pose>
          <geometry><box><size>0.4 0.55 0.05</size></box></geometry>
          <material><ambient>0.2 0.7 0.9 0.8</ambient><diffuse>0.2 0.7 0.9 0.8</diffuse></material>
        </visual>
      </link>

      <!-- 4 Wheels -->
      <link name="fl_wheel">
        <pose>0.32 0.34 -0.05 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>
      <link name="fr_wheel">
        <pose>0.32 -0.34 -0.05 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>
      <link name="rl_wheel">
        <pose>-0.32 0.34 -0.05 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>
      <link name="rr_wheel">
        <pose>-0.32 -0.34 -0.05 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>10</mu><mu2>10</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>

      <!-- Rooftop LiDAR -->
      <link name="lidar_link">
        <pose>0.2 0 0.30 0 0 0</pose><inertial><mass>0.1</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.1</length></cylinder></geometry><material><ambient>0.9 0.1 0.1 1</ambient></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate>
          <topic>/car/scan</topic>
          <lidar>
            <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-2.0</min_angle><max_angle>2.0</max_angle></horizontal></scan>
            <range><min>0.2</min><max>15.0</max><resolution>0.02</resolution></range>
          </lidar>
        </sensor>
      </link>

      <!-- Forward-Facing Downward-Angled Lane Detection Camera -->
      <link name="camera_link">
        <pose>0.45 0 0.22 0 0.35 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><box><size>0.08 0.1 0.06</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <sensor name="front_camera" type="camera">
          <always_on>true</always_on><update_rate>15</update_rate><visualize>true</visualize>
          <topic>/car/camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>35.0</far></clip>
          </camera>
        </sensor>
      </link>

      <joint name="fl_joint" type="revolute"><parent>chassis</parent><child>fl_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="fr_joint" type="revolute"><parent>chassis</parent><child>fr_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rl_joint" type="revolute"><parent>chassis</parent><child>rl_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rr_joint" type="revolute"><parent>chassis</parent><child>rr_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="lidar_j" type="fixed"><parent>chassis</parent><child>lidar_link</child></joint>
      <joint name="cam_j" type="fixed"><parent>chassis</parent><child>camera_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>fl_joint</left_joint>
        <left_joint>rl_joint</left_joint>
        <right_joint>fr_joint</right_joint>
        <right_joint>rr_joint</right_joint>
        <wheel_separation>0.68</wheel_separation>
        <wheel_radius>0.16</wheel_radius>
        <odom_topic>/car/odometry</odom_topic>
        <topic>/car/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
