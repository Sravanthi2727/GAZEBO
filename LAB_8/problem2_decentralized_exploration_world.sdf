            <range><min>0.25</min><max>8.0</max><resolution>0.03</resolution></range>
          </lidar>
        </sensor>
      </link>
      <joint name="lwj3" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rwj3" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="cfj3" type="fixed"><parent>base_link</parent><child>caster_f</child></joint>
      <joint name="crj3" type="fixed"><parent>base_link</parent><child>caster_r</child></joint>
      <joint name="lj3" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>lwj3</left_joint><right_joint>rwj3</right_joint>
        <wheel_separation>0.56</wheel_separation><wheel_radius>0.18</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/robot3/odometry</odom_topic><topic>/robot3/cmd_vel</topic>
      </plugin>
    </model>

  </world>
</sdf>
