        <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry>
          <surface><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.07</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <link name="caster_f">
        <pose>0.24 0 -0.10 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <link name="caster_r">
        <pose>-0.24 0 -0.10 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.08</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><sphere><radius>0.08</radius></sphere></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <link name="lidar_link">
        <pose>0.15 0 0.20 0 0 0</pose>
        <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.08</radius><length>0.08</length></cylinder></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate>
          <topic>/robot1/scan</topic>
          <lidar>
            <scan><horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
            <range><min>0.25</min><max>8.0</max><resolution>0.03</resolution></range>
          </lidar>
        </sensor>
      </link>
      <joint name="lwj1" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="rwj1" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <joint name="cfj1" type="fixed"><parent>base_link</parent><child>caster_f</child></joint>
      <joint name="crj1" type="fixed"><parent>base_link</parent><child>caster_r</child></joint>
      <joint name="lj1" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>lwj1</left_joint><right_joint>rwj1</right_joint>
        <wheel_separation>0.56</wheel_separation><wheel_radius>0.18</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/robot1/odometry</odom_topic><topic>/robot1/cmd_vel</topic>
      </plugin>
    </model>

